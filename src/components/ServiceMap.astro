---
// The three services as one connected system: Grow feeds Automate, Automate is guarded by
// Protect. Each card carries its service colour. Plays once when scrolled into view.
// Decorative, because the services are described in text next to it.
import { serviceVerbs } from '../data/home';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { marketing, automation, security } = serviceVerbs;
---

<svg viewBox="0 0 480 548" class:list={['service-map h-auto w-full', className]} aria-hidden="true" focusable="false">
  <path
    class="connector connector-1 fill-none stroke-brand-light"
    d="M150 206 V 257 Q150 297 190 297 H200"
    pathLength="1"
    stroke-width="3"
    stroke-linecap="round"
  />
  <path
    class="connector connector-2 fill-none stroke-brand-light"
    d="M330 372 V 415 Q330 455 290 455"
    pathLength="1"
    stroke-width="3"
    stroke-linecap="round"
  />

  <g class="tile tile-1">
    <rect x="20" y="37" width="260" height="176" rx="18" class="fill-[#c3d0e6]" />
    <rect x="20" y="30" width="260" height="176" rx="18" class="fill-panel stroke-line" stroke-width="1.5" />
    <circle cx="254" cy="56" r="7" class="fill-grow" />
    <text x="44" y="68" class="fill-fg" font-size="20" font-weight="600">{marketing.verb}</text>
    <text x="44" y="90" class="fill-grow-ink" font-size="13" font-weight="500">{marketing.label}</text>
    <rect x="44" y="160" width="22" height="26" rx="4" class="fill-grow" opacity=".35" />
    <rect x="76" y="146" width="22" height="40" rx="4" class="fill-grow" opacity=".55" />
    <rect x="108" y="128" width="22" height="58" rx="4" class="fill-grow" opacity=".8" />
    <rect x="140" y="108" width="22" height="78" rx="4" class="fill-brand" />
    <path
      d="M182 172 L206 150 L228 158 L254 118"
      class="fill-none stroke-fg"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="254" cy="118" r="6" class="fill-base stroke-fg" stroke-width="2.5" />
  </g>

  <g class="tile tile-2">
    <rect x="200" y="229" width="260" height="150" rx="18" class="fill-[#c3d0e6]" />
    <rect x="200" y="222" width="260" height="150" rx="18" class="fill-panel stroke-line" stroke-width="1.5" />
    <circle cx="434" cy="248" r="7" class="fill-ai" />
    <text x="224" y="260" class="fill-fg" font-size="20" font-weight="600">{automation.verb}</text>
    <text x="224" y="282" class="fill-ai-ink" font-size="13" font-weight="500">{automation.label}</text>
    <path d="M254 330 H306 M334 330 H386" class="stroke-ai" stroke-opacity=".4" stroke-width="3" stroke-linecap="round" />
    <circle cx="240" cy="330" r="14" class="fill-ai-soft stroke-ai" stroke-width="2" />
    <circle cx="320" cy="330" r="16" class="fill-ai" />
    <path d="M320 320 L323 327 L330 330 L323 333 L320 340 L317 333 L310 330 L317 327 Z" class="fill-white" />
    <circle cx="400" cy="330" r="14" class="fill-brand" />
    <path d="M394 330 L398 334 L406 326" class="fill-none stroke-white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  </g>

  <g class="tile tile-3">
    <rect x="30" y="397" width="260" height="130" rx="18" class="fill-[#c3d0e6]" />
    <rect x="30" y="390" width="260" height="130" rx="18" class="fill-panel stroke-line" stroke-width="1.5" />
    <text x="54" y="428" class="fill-fg" font-size="20" font-weight="600">{security.verb}</text>
    <text x="54" y="450" class="fill-secure-ink" font-size="13" font-weight="500">{security.label}</text>
    <path
      d="M240 418 L268 429 V454 C268 473 256 486 240 492 C224 486 212 473 212 454 V429 Z"
      class="fill-secure"
    />
    <path d="M228 455 L237 464 L253 446" class="fill-none stroke-white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  </g>

  <circle cx="150" cy="206" r="5" class="fill-brand-light" />
  <circle cx="330" cy="372" r="5" class="fill-brand-light" />
</svg>

<script>
  // Hide the cards only when they will be animated in, so the map is never left blank
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && 'IntersectionObserver' in window) {
    document.querySelectorAll<SVGElement>('.service-map').forEach((map) => {
      map.setAttribute('data-animate', '');
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            map.classList.add('is-visible');
            observer.disconnect();
          }
        },
        { threshold: 0.2 },
      );
      observer.observe(map);
    });
  }
</script>
