---
// A piece of work: a 9:16 reel (hero feed) or a 16:10 browser window (case study covers).
// A reel can carry a short muted video (played by the hero only while it is in view); without
// media it renders as a tinted placeholder with its caption.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Tone } from '../data/home';

interface Props {
  tone: Tone;
  title: string;
  caption: string;
  shape?: 'reel' | 'browser';
  image?: ImageMetadata | undefined;
  alt?: string | undefined;
  /** Muted looping video for a reel, from public/videos, with a poster frame */
  video?: string | undefined;
  poster?: string | undefined;
  /** Hide from assistive tech when the same information sits next to the frame */
  decorative?: boolean;
  class?: string;
}

const {
  tone,
  title,
  caption,
  shape = 'reel',
  image,
  alt = '',
  video,
  poster,
  decorative = false,
  class: className,
} = Astro.props;

const tones: Record<Tone, string> = {
  white: 'bg-panel text-fg',
  ink: 'bg-ink text-white',
  night: 'bg-night text-white',
  deep: 'bg-brand-deep text-white',
  violet: 'bg-ai text-white',
  teal: 'bg-secure text-white',
  sky: 'bg-grow-soft text-grow-ink',
};

const isReel = shape === 'reel';
---

<figure
  class:list={[
    'relative flex flex-col overflow-hidden',
    isReel ? 'reel-3d aspect-[9/16] rounded-[1.25rem]' : 'aspect-[16/10] rounded-xl',
    tones[tone],
    className,
  ]}
  aria-hidden={decorative ? 'true' : undefined}
>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[400, 800, 1200]}
        sizes="(min-width: 64rem) 30rem, 90vw"
        class="absolute inset-0 h-full w-full object-cover object-top"
      />
    ) : isReel && video ? (
      <>
        <video
          class="absolute inset-0 h-full w-full object-cover"
          muted
          loop
          playsinline
          preload="none"
          poster={poster}
          disablepictureinpicture
          aria-hidden="true"
          data-reel-video
        >
          <source src={video} type="video/mp4" />
        </video>
        <div
          class="pointer-events-none absolute inset-0"
          style="background: linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 48%), linear-gradient(to bottom, rgb(0 0 0 / 0.32), transparent 22%)"
          aria-hidden="true"
        />
        <div class="relative flex shrink-0 gap-1 px-3 pt-3" aria-hidden="true">
          <span class="h-[3px] flex-1 rounded-full bg-white/85" />
          <span class="h-[3px] flex-1 rounded-full bg-white/35" />
          <span class="h-[3px] flex-1 rounded-full bg-white/35" />
        </div>
        <figcaption class="relative mt-auto px-4 pb-4 text-white">
          <span class="type-label block font-normal">{title}</span>
          <span class="mt-0.5 block text-[1.0625rem] font-medium leading-tight">{caption}</span>
        </figcaption>
      </>
    ) : isReel ? (
      <>
        <div class="flex shrink-0 gap-1 px-3 pt-3" aria-hidden="true">
          <span class="h-[3px] flex-1 rounded-full bg-current opacity-80" />
          <span class="h-[3px] flex-1 rounded-full bg-current opacity-30" />
          <span class="h-[3px] flex-1 rounded-full bg-current opacity-30" />
        </div>
        <div class="grid flex-1 place-items-center" aria-hidden="true">
          <span class="grid size-12 place-items-center rounded-full bg-current/15">
            <svg viewBox="0 0 24 24" class="ml-0.5 size-5 fill-current">
              <path d="M7 4.5 L19 12 L7 19.5 Z" />
            </svg>
          </span>
        </div>
        <figcaption class="shrink-0 px-4 pb-4">
          <span class="type-label block font-normal">{title}</span>
          <span class="mt-0.5 block text-[1.0625rem] font-medium leading-tight">{caption}</span>
        </figcaption>
      </>
    ) : (
      <>
        <div class="flex h-6 shrink-0 items-center gap-1.5 bg-black/10 px-3" aria-hidden="true">
          <span class="size-2 rounded-full bg-current opacity-40" />
          <span class="size-2 rounded-full bg-current opacity-40" />
          <span class="size-2 rounded-full bg-current opacity-40" />
          <span class="ml-2 h-2.5 w-2/5 rounded-full bg-current opacity-20" />
        </div>
        <div class="flex min-h-0 flex-1 flex-col gap-2 overflow-hidden p-[6%]" aria-hidden="true">
          <span class="h-2 w-1/5 rounded-full bg-current opacity-50" />
          <span class="mt-[4%] h-2.5 w-3/5 shrink-0 rounded-full bg-current opacity-60" />
          <span class="h-2.5 w-2/5 shrink-0 rounded-full bg-current opacity-60" />
        </div>
        <figcaption class="shrink-0 px-4 pb-3.5">
          <span class="type-label block font-normal">{title}</span>
          <span class="mt-0.5 block text-[1.0625rem] font-medium leading-tight">{caption}</span>
        </figcaption>
      </>
    )
  }
</figure>
