---
// Google Analytics 4, loaded only after the visitor accepts analytics cookies. UK GDPR and PECR
// need consent before analytics cookies are set. With no measurement ID in site.ts, this
// renders nothing at all.
import { site } from '../data/site';

const measurementId = site.analytics.gaMeasurementId;
---

{
  measurementId && (
    <>
      <div
        data-consent
        hidden
        role="region"
        aria-label="Cookie choice"
        class="on-brand fixed inset-x-4 bottom-4 z-40 mx-auto max-w-xl rounded-2xl bg-ink p-5 text-white ring-1 ring-white/15 sm:p-6"
      >
        <p>
          Can we use Google Analytics cookies to see how people use this site? They are only set if you accept.{' '}
          <a class="underline underline-offset-2" href="/privacy/">Privacy policy</a>
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" data-consent-choice="granted" class="button-primary button-accent button-small">
            Accept
          </button>
          <button
            type="button"
            data-consent-choice="denied"
            class="button-primary button-small bg-transparent text-white ring-1 ring-white hover:bg-white/10"
          >
            Reject
          </button>
        </div>
      </div>
      <script is:inline define:vars={{ measurementId }}>
        const KEY = 'analytics-consent';
        const banner = document.querySelector('[data-consent]');
        let loaded = false;

        const read = () => {
          try {
            return localStorage.getItem(KEY);
          } catch {
            return null;
          }
        };

        const load = () => {
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', measurementId);
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
          document.head.append(script);
        };

        const clearCookies = () => {
          document.cookie.split(';').forEach((cookie) => {
            const name = cookie.split('=')[0].trim();
            if (name.startsWith('_ga')) {
              document.cookie = `${name}=; Max-Age=0; path=/; domain=${location.hostname.replace(/^www\./, '.')}`;
              document.cookie = `${name}=; Max-Age=0; path=/`;
            }
          });
        };

        const choice = read();
        if (choice === 'granted') load();
        else if (choice !== 'denied') banner.hidden = false;

        banner.querySelectorAll('[data-consent-choice]').forEach((button) => {
          button.addEventListener('click', () => {
            const value = button.dataset.consentChoice;
            try {
              localStorage.setItem(KEY, value);
            } catch {}
            banner.hidden = true;
            if (value === 'granted') {
              load();
            } else if (loaded) {
              clearCookies();
              location.reload();
            } else {
              clearCookies();
            }
          });
        });

        document.querySelectorAll('[data-consent-open]').forEach((button) => {
          button.hidden = false;
          button.addEventListener('click', () => {
            banner.hidden = false;
            banner.querySelector('button')?.focus();
          });
        });
      </script>
    </>
  )
}
