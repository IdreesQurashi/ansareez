---
// Service banners, one per service in its own hue on a dark tint of it. Surfaces use the
// panel colour, fine detail uses the text colour at low opacity. Decorative, because each
// sits beside its service name and description.
import type { ServiceKey } from '../data/home';

interface Props {
  kind: ServiceKey;
  class?: string;
}

const { kind, class: className } = Astro.props;

const panel: Record<ServiceKey, string> = {
  marketing: 'fill-grow-soft',
  automation: 'fill-ai-soft',
  security: 'fill-secure-soft',
};
---

<svg viewBox="0 0 480 300" class:list={['h-auto w-full', className]} aria-hidden="true" focusable="false">
  <rect width="480" height="300" rx="24" class={panel[kind]} />
  {
    kind === 'marketing' && (
      <g>
        <circle cx="400" cy="70" r="46" class="fill-grow" opacity=".1" />
        <rect x="140" y="36" width="124" height="228" rx="20" class="fill-panel stroke-line" stroke-width="2" />
        <rect x="186" y="48" width="32" height="5" rx="2.5" class="fill-fg" opacity=".25" />
        <rect x="154" y="66" width="96" height="78" rx="10" class="fill-grow" />
        <circle cx="178" cy="92" r="9" class="fill-white" opacity=".85" />
        <path d="M154 136 L190 104 L214 124 L230 110 L250 128 V144 H154 Z" class="fill-white" opacity=".55" />
        <rect x="154" y="156" width="78" height="8" rx="4" class="fill-fg" opacity=".35" />
        <rect x="154" y="172" width="58" height="8" rx="4" class="fill-fg" opacity=".2" />
        <rect x="154" y="196" width="96" height="30" rx="15" class="fill-brand" />
        <circle cx="300" cy="84" r="28" class="fill-brand" />
        <path
          d="M300 96 C288 87 284 81 287 75 C290 69 297 69 300 75 C303 69 310 69 313 75 C316 81 312 87 300 96 Z"
          class="fill-white"
        />
        <circle cx="96" cy="120" r="20" class="fill-panel stroke-line" stroke-width="2" />
        <path d="M88 120 H104 M96 112 V128" class="stroke-grow-ink" stroke-width="3" stroke-linecap="round" />
        <path
          d="M300 238 L338 206 L366 220 L420 160"
          class="fill-none stroke-grow-ink"
          stroke-width="7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path d="M398 158 H422 V182" class="fill-none stroke-grow-ink" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )
  }
  {
    kind === 'automation' && (
      <g>
        <circle cx="80" cy="250" r="40" class="fill-ai" opacity=".12" />
        <rect x="44" y="104" width="104" height="92" rx="16" class="fill-panel stroke-line" stroke-width="2" />
        <rect x="68" y="130" width="56" height="40" rx="6" class="fill-none stroke-fg" stroke-width="4" opacity=".8" />
        <path d="M70 134 L96 154 L122 134" class="fill-none stroke-fg" stroke-width="4" stroke-linejoin="round" opacity=".8" />
        <rect x="186" y="84" width="108" height="132" rx="20" class="fill-ai" />
        <path
          d="M240 112 L248 140 L276 150 L248 160 L240 188 L232 160 L204 150 L232 140 Z"
          class="fill-white"
        />
        <circle cx="270" cy="114" r="6" class="fill-white" opacity=".6" />
        <rect x="332" y="104" width="104" height="92" rx="16" class="fill-panel stroke-line" stroke-width="2" />
        <path d="M356 132 H412 M356 150 H400 M356 168 H408" class="stroke-fg" stroke-width="4" stroke-linecap="round" opacity=".3" />
        <circle cx="410" cy="128" r="14" class="fill-brand" />
        <path d="M403 128 L408 133 L417 123" class="fill-none stroke-white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M150 150 H180 M296 150 H326" class="stroke-ai-ink" stroke-width="4" stroke-linecap="round" />
        <path d="M172 142 L182 150 L172 158 M318 142 L328 150 L318 158" class="fill-none stroke-ai-ink" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="186" y="236" width="108" height="10" rx="5" class="fill-ai" opacity=".45" />
      </g>
    )
  }
  {
    kind === 'security' && (
      <g>
        <circle cx="430" cy="250" r="44" class="fill-secure" opacity=".2" />
        <rect x="52" y="62" width="236" height="176" rx="16" class="fill-panel stroke-line" stroke-width="2" />
        <rect x="52" y="62" width="236" height="28" rx="14" class="fill-secure" opacity=".35" />
        <circle cx="72" cy="76" r="4" class="fill-secure-ink" opacity=".8" />
        <circle cx="86" cy="76" r="4" class="fill-secure-ink" opacity=".8" />
        <circle cx="100" cy="76" r="4" class="fill-secure-ink" opacity=".8" />
        <rect x="76" y="112" width="120" height="10" rx="5" class="fill-fg" opacity=".35" />
        <rect x="76" y="132" width="164" height="10" rx="5" class="fill-fg" opacity=".2" />
        <rect x="76" y="152" width="140" height="10" rx="5" class="fill-fg" opacity=".2" />
        <rect x="76" y="176" width="64" height="28" rx="8" class="fill-brand" />
        <circle cx="236" cy="188" r="44" class="fill-base stroke-fg" stroke-width="9" />
        <path d="M268 220 L300 252" class="stroke-fg" stroke-width="12" stroke-linecap="round" />
        <path
          d="M378 66 L428 86 V130 C428 164 406 188 378 200 C350 188 328 164 328 130 V86 Z"
          class="fill-secure"
        />
        <path d="M356 132 L372 148 L402 116" class="fill-none stroke-white" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="336" y="222" width="84" height="10" rx="5" class="fill-secure-ink" opacity=".7" />
        <rect x="350" y="242" width="56" height="10" rx="5" class="fill-secure-ink" opacity=".4" />
      </g>
    )
  }
</svg>
