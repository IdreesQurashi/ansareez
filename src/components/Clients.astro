---
// The team's track record: the client count and the brands it has worked with. On the live
// site the section stays hidden if the logo list is ever emptied. In development an empty
// list shows labelled placeholder slots so the layout can still be judged.
import { Image } from 'astro:assets';
import { clients } from '../data/home';
import { clientLogos, clientTotal } from '../data/clients';

const preview = clientLogos.length === 0 && import.meta.env.DEV;
const show = clientLogos.length > 0 || preview;
// Rounded down to the nearest ten, so the "more" tile never overstates
const notPictured = Math.floor((clientTotal - clientLogos.length) / 10) * 10;
---

{
  show && (
    <section id="clients" class="scroll-mt-4 bg-raise py-16 md:py-20" aria-labelledby="clients-heading">
      <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8">
        <div class="md:flex md:items-end md:justify-between md:gap-12">
          <h2 id="clients-heading" class="type-h2">
            {clients.heading}
          </h2>
          <p class="mt-3 max-w-[36ch] text-fg-soft md:mt-0">{clients.intro}</p>
        </div>

        {preview && (
          <p class="mt-6 type-label text-fg-soft">
            Preview only, not shown on the live site: add logos in src/data/clients.ts.
          </p>
        )}

        <ul class="mt-10 grid grid-cols-3 gap-3 sm:gap-4 md:grid-cols-6 md:gap-5" role="list">
          {preview
            ? Array.from({ length: 12 }, () => (
                <li
                  class="grid aspect-[3/2] place-items-center rounded-2xl border-2 border-dashed border-line"
                  aria-hidden="true"
                >
                  <span class="type-label text-fg-soft">Client logo</span>
                </li>
              ))
            : clientLogos.map((client) => {
                const logo = (
                  <Image
                    src={client.logo}
                    alt={client.name}
                    widths={[160, 320]}
                    sizes="(min-width: 48rem) 11rem, 30vw"
                    class="absolute inset-0 m-auto h-auto max-h-[60%] w-auto max-w-[76%] object-contain"
                  />
                );
                return (
                  <li class="slab tilt-glare relative aspect-[3/2] rounded-2xl" data-tilt="14">
                    {client.url ? (
                      <a
                        href={client.url}
                        target="_blank"
                        rel="noopener"
                        class="absolute inset-0 rounded-2xl hover:bg-panel"
                      >
                        {logo}
                      </a>
                    ) : (
                      logo
                    )}
                  </li>
                );
              })}
          {!preview && notPictured >= 10 && (
            <li class="slab slab-blue tilt-glare grid aspect-[3/2] place-items-center rounded-2xl px-2 text-center" data-tilt="14">
              <p>
                <span class="block text-2xl font-semibold leading-none md:text-3xl">{notPictured}+</span>
                <span class="mt-1 block type-label text-fg-soft">{clients.more}</span>
              </p>
            </li>
          )}
        </ul>
      </div>
    </section>
  )
}
