---
import { faq } from '../data/home';
---

<section id="faq" class="scroll-mt-4 bg-raise py-20 md:py-28" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:grid lg:grid-cols-12 lg:gap-8 lg:px-8">
    <h2 id="faq-heading" class="type-h2 lg:col-span-5">{faq.heading}</h2>
    <div class="mt-10 lg:col-span-7 lg:mt-1">
      {
        faq.items.map((item) => (
          <details name="faq" class="group border-b border-line first:border-t">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
              <span class="type-h3">{item.q}</span>
              <span
                class="mt-1 grid size-8 shrink-0 place-items-center rounded-full border border-fg/25 text-xl leading-none transition-[rotate] duration-200 group-open:rotate-45 motion-reduce:transition-none"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="max-w-[58ch] pb-6 text-fg-soft">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
