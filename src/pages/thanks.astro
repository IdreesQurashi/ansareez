---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent" noindex>
  <section class="mx-auto max-w-[76rem] px-4 py-24 sm:px-6 md:py-32 lg:px-8">
    <h1 class="type-h2 max-w-[18ch]">Thanks, your message is on its way.</h1>
    <p class="type-lead mt-6 max-w-[44ch] text-fg-soft">We have your message and will reply by email.</p>
    <p class="mt-9"><a class="button-primary button-accent" href="/">Back to the home page</a></p>
  </section>
</Base>
