---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="mx-auto max-w-[76rem] px-4 py-24 sm:px-6 md:py-32 lg:px-8">
    <h1 class="type-h2 max-w-[18ch]">This page does not exist.</h1>
    <p class="type-lead mt-6 max-w-[44ch] text-fg-soft">The link may be old or mistyped. The home page has everything else.</p>
    <p class="mt-9"><a class="button-primary button-accent" href="/">Go to the home page</a></p>
  </section>
</Base>
